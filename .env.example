# 개발용 환경변수. `cp .env.example .env`로 복사해서 쓴다. `.env`는 Git에 올라가지 않는다.
#
# - 개발 실행(`pnpm dev`)에서만 읽는다. 패키징된 앱은 이 파일이 있어도 읽지 않는다.
# - 셸에서 이미 지정한 값이 우선한다. 예: JARVIS_SERVER_URL=… pnpm dev
# - 공백이나 JSON이 든 값은 따옴표로 감싼다.
# - ELECTRON_RUN_AS_NODE는 이 파일로 해결되지 않는다. VS Code 터미널에서 앱이 일반 Node로 실행되면
#   `env -u ELECTRON_RUN_AS_NODE pnpm dev`로 실행한다.
# - ELECTRON_RENDERER_URL은 개발 서버가 자동으로 정하므로 건드리지 않는다.
#
# 켜 둔 것은 서버 주소 하나뿐이다. 개발용 대역과 가짜 장치는 켜면 서버나 실제 장치 대신 가짜가
# 동작하므로 필요할 때만 주석을 푼다.

# --- 서버 -------------------------------------------------------------------------------------
# 서버 주소. 유효하면 로그인, 글·음성 대화, 명령 실행, 추천이 이 서버를 쓴다.
# https 또는 같은 PC의 http만 허용한다. 개발용 가짜 서버는 http://127.0.0.1:8765/api/v1
JARVIS_SERVER_URL=http://127.0.0.1:8001/api/v1

# --- 패키징(빌드할 때만 쓰는 값) ----------------------------------------------------------------
# 설치본이 연결할 서버 주소. `pnpm package`·`pnpm package:dir`를 할 때 앱 코드에 들어가며 실행 중에는
# 바꿀 수 없다. 설치본은 위의 JARVIS_SERVER_URL을 읽지 않는다. 값이 없거나 https가 아니거나 이 PC를
# 가리키면(localhost 등) 패키징이 시작 전에 중단된다. 보통 셸에서 지정한다.
#   MAIN_VITE_JARVIS_SERVER_URL=https://api.example.com/api/v1 pnpm package
# MAIN_VITE_JARVIS_SERVER_URL=https://api.example.com/api/v1

# --- 개발용 대역 ------------------------------------------------------------------------------
# 로그인을 개발용 대역으로 바꾼다(계정 demo / demo1234). 서버보다 우선하며, 이때는 명령·추천을 받지 않는다.
# JARVIS_DEV_AUTH=1
# 대화와 음성을 개발용 대역으로 바꾼다. 서버보다 우선한다.
# JARVIS_DEV_SPEECH=1
# 위 대역이 몇 번 주고받은 뒤 대화를 끝낼지(기본 2)
# JARVIS_DEV_SPEECH_TURNS=2

# --- 화면 -------------------------------------------------------------------------------------
# 상태 알약(오버레이)을 끈다. 추천 팝업에는 영향이 없다.
# JARVIS_NO_OVERLAY=1
# 반투명 창 효과를 켠다(기본은 불투명).
# JARVIS_NATIVE_WINDOW_EFFECTS=1

# --- 가짜 마이크·카메라·포인터 ------------------------------------------------------------------
# 가짜 카메라·마이크를 쓴다. 아래 두 파일 변수의 전제다.
# JARVIS_FAKE_MEDIA=1
# 마이크 입력으로 쓸 WAV 파일(16kHz 모노 16비트, 부가 청크가 없는 것). macOS에서는 파일을 읽으려면
# 실행에 --no-sandbox가 필요할 수 있다.
# JARVIS_FAKE_AUDIO_FILE=/path/to/utterance.wav
# 카메라 입력으로 쓸 영상(y4m 또는 mjpeg)
# JARVIS_FAKE_VIDEO_FILE=/path/to/hand.y4m
# 제스처가 실제 마우스를 움직이지 않고 로그만 남긴다.
# JARVIS_FAKE_POINTER=1

# --- 자체 시험(로그인 뒤 자동 실행, 결과를 로그 줄로 출력) -----------------------------------------
# 진단용 사용권을 잡고 로그에 출력한다.
# JARVIS_SENSOR_SELFTEST=1
# 그 횟수만큼 발화를 듣고 위치·길이를 VOICE_SELFTEST 줄로 출력한다(오디오 제외).
# JARVIS_VOICE_SELFTEST=1
# 음성 대화를 한 번 시작하고 상태 변화를 SPEECH_SELFTEST 줄로 출력한다.
# JARVIS_SPEECH_SELFTEST=1
# 그 시간(초) 동안 손 관절 인식 요약을 HAND_SELFTEST 줄로 출력한다.
# JARVIS_HAND_SELFTEST=5
# 도구 요청 JSON 배열을 로그인 직후 실행하고 보고를 TOOL_SELFTEST 줄로 출력한다. 따옴표로 감싼다.
# JARVIS_TOOL_SELFTEST='[{"requestId":"r1","executionId":"e1","command":{"tool":"apps.list","arguments":{}}}]'
