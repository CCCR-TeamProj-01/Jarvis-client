{
  "name": "jarvis-client",
  "version": "0.1.0",
  "private": true,
  "description": "Jarvis desktop client for Windows and macOS",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "models:fetch": "node scripts/fetch-models.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "package:dir": "pnpm models:fetch && pnpm build && electron-builder --dir",
    "package": "pnpm models:fetch && pnpm build && electron-builder"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.1.1",
    "better-sqlite3": "^13.0.3",
    "electron-store": "^12.0.0",
    "lucide-react": "^1.59.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sherpa-onnx-node": "^1.13.8",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
