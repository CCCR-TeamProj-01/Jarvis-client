{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 100,
  "ignorePatterns": [
    "out",
    "release",
    "node_modules",
    "pnpm-lock.yaml",
    "docs/archive",
    "docs",
    "**/*.md",
    ".context",
    "package.json"
  ]
}
